# ==============================================================================
# AUTOMATION TOOLS - ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. EMAIL OUTREACH & INBOX COPILOT (GMAIL SMTP / IMAP)
# ------------------------------------------------------------------------------
# Gmail SMTP Configuration (for sending outreach emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
# Use an App Password generated at: https://myaccount.google.com/apppasswords
SMTP_PASSWORD=your_16_character_app_password
SENDER_NAME="Your Name"
SENDER_EMAIL=your_email@gmail.com

# Gmail IMAP Configuration (for reading, searching & summarizing inbox)
IMAP_HOST=imap.gmail.com
IMAP_PORT=993

# ------------------------------------------------------------------------------
# 2. LLM CONFIGURATION (MULTI-PROVIDER SUPPORT)
# Set at least one provider API key below:
# ------------------------------------------------------------------------------
# Option A: OpenAI (GPT-4o / GPT-4o-mini)
OPENAI_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-4o

# Option B: Google Gemini
# GEMINI_API_KEY=your_gemini_api_key_here
# LLM_MODEL=gemini-2.0-flash

# Option C: Anthropic Claude
# ANTHROPIC_API_KEY=your_anthropic_api_key_here
# LLM_MODEL=claude-3-5-sonnet-20241022

# Option D: Kie.ai DeepSeek
# KIE_API_KEY=your_kie_api_key_here
# KIE_MODEL=deepseek-v4-1-flash

# ------------------------------------------------------------------------------
# 3. JOB CO-PILOT BROWSER BRIDGE
# ------------------------------------------------------------------------------
# Remote debugging port for local Chrome (preserves sessions & prevents bot bans)
CHROME_DEBUG_PORT=9222
HEADLESS=false

# Candidate profile file path (default: data/candidate_profile.json)
CANDIDATE_PROFILE_PATH=data/candidate_profile.json

# ------------------------------------------------------------------------------
# 4. SERPER.DEV WEB LEAD SCRAPER
# ------------------------------------------------------------------------------
# Free API key from https://serper.dev (2,500 free Google Places/Search queries)
SERPER_API_KEY=your_serper_api_key_here
